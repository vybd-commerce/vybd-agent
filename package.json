{
  "name": "vybd-agent",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo": "VYBD_DEMO=1 BUILDER_POLL_MS=1500 next dev",
    "build": "next build",
    "start": "sh scripts/start.sh",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx --env-file=.env.local src/worker/index.ts",
    "start:worker": "tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "make-operator": "tsx --env-file=.env.local scripts/make-operator.ts",
    "backfill-builder": "tsx --env-file=.env.local scripts/backfill-builder.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sentry/node": "^11.11.0",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.19.0"
}
