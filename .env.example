DATABASE_URL=postgres://localhost:5432/vybd_agent
APP_URL=http://localhost:3000

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Optional: Google sign-in. Magic links are printed to the server log.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails that get operator access to /ops
OPERATOR_EMAILS=

ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5)
VYBD_MODEL=

# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
