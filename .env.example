DATABASE_URL=postgres://localhost:5432/vybd_agent
# Neon: DATABASE_URL = pooled string (host has -pooler), DATABASE_URL_DIRECT = same without -pooler (migrations and live-update LISTEN; required on Neon).
DATABASE_URL_DIRECT=
APP_URL=http://localhost:3000

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Google sign-in. Redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic links via Resend (needs a verified sending domain). Unset: links print to the
# server log in development; production is Google-only.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=

# Private beta. Sign-in is limited to BETA_ALLOWLIST (emails or @domains), OPERATOR_EMAILS,
# existing accounts, waitlist entries approved in /ops/waitlist, and brand invite links.
# BETA_GATE=off opens sign-up. BETA_FREE_JOBS=1 skips checkout for every job.
BETA_ALLOWLIST=
BETA_GATE=
BETA_FREE_JOBS=

# Job worker. Production: slow idle poll so Neon scales to zero; the web app wakes the worker
# over WORKER_URL (Railway private network, e.g. http://worker.railway.internal:8080).
# Production: 1800000 (30 min), so the Neon free tier can suspend between polls.
WORKER_POLL_MS=3000
WORKER_PORT=
WORKER_URL=
WORKER_TOKEN=

# Comma-separated emails that get operator access to /ops
OPERATOR_EMAILS=

ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5)
VYBD_MODEL=

# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: run the web chat on free OpenRouter models while there is no ANTHROPIC_API_KEY.
# Used automatically when ANTHROPIC_API_KEY is empty; force either with VYBD_PROVIDER=anthropic|openrouter.
# The market snapshot worker still needs ANTHROPIC_API_KEY (server-side web search).
OPENROUTER_API_KEY=
# Comma-separated; OpenRouter tries them in order. Default: nemotron-3-ultra, gemma-4-31b, inkling (all :free).
OPENROUTER_MODEL=
VYBD_PROVIDER=

# Vybd Brand Builder (vybd-brand-builder): owns the canonical brief and runs brand research.
# Leave BUILDER_API_URL empty to keep the brief local only. BUILDER_MODE=fake uses an in-memory builder (tests, demos).
BUILDER_API_URL=
BUILDER_SERVICE_TOKEN=
BUILDER_MODE=
# How often the worker polls a research run (ms).
BUILDER_POLL_MS=5000

# Optional: error reporting for the web server and worker (sentry.io free tier).
SENTRY_DSN=
